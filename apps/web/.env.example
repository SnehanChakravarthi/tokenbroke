DATABASE_URL=postgresql://user:password@host.example/database?sslmode=require
GITHUB_CLIENT_ID=github-client-id
GITHUB_CLIENT_SECRET=github-client-secret
CLAIM_SECRET=replace-with-a-long-random-secret
ADMIN_TOKEN=replace-with-a-long-random-token
# Canonical public origin (scheme + host, no trailing slash). Used to build the OAuth redirect_uri
# and to enforce the same-origin check on claim start, so an attacker-controlled Host header cannot
# steer the flow. Required in production; falls back to the request origin only when unset.
APP_ORIGIN=https://tokenbroke.lol
