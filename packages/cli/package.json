{
  "name": "tokenbroke",
  "version": "0.1.11",
  "description": "Are you tokenbroke? Prove it. Reads your local Codex CLI / Claude Code usage and ranks you on the leaderboard of the most rate-limited developers alive.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SnehanChakravarthi/tokenbroke.git",
    "directory": "packages/cli"
  },
  "homepage": "https://tokenbroke.lol",
  "bugs": "https://github.com/SnehanChakravarthi/tokenbroke/issues",
  "type": "module",
  "bin": {
    "tokenbroke": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bench:readers": "bun scripts/bench-readers.ts",
    "build": "tsup",
    "dev": "tsup --watch",
    "readers:dump": "bun scripts/dump-readers.ts",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "demo": "bun run build && bun scripts/demo.ts"
  },
  "devDependencies": {
    "@tokenbroke/shared": "workspace:*",
    "@types/node": "^20",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^3.2.0"
  },
  "keywords": [
    "rate-limit",
    "claude-code",
    "codex",
    "leaderboard",
    "cli",
    "tokenbroke"
  ],
  "author": "Snehan Chakravarthi (https://x.com/theteknosaur)"
}
