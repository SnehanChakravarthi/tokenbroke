{
  "name": "tokenbroke",
  "version": "0.0.0",
  "description": "Are you tokenbroke? Prove it. Reads your local Codex CLI / Claude Code usage and ranks you on the leaderboard of the most rate-limited developers alive.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tokenbroke": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bench:readers": "bun scripts/bench-readers.ts",
    "build": "tsup",
    "dev": "tsup --watch",
    "readers:dump": "bun scripts/dump-readers.ts",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "demo": "bun run build && bun scripts/demo.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@tokenbroke/shared": "workspace:*",
    "@types/node": "^20",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^3.2.0"
  }
}
