{
  "name": "tokenbroke-monorepo",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun run --filter @tokenbroke/web dev",
    "build": "bun run --filter '*' build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "demo": "cd packages/cli && bun run demo",
    "readers": "cd packages/cli && bun run readers:dump",
    "bump:cli": "node scripts/bump-cli.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "typescript": "^5.9.0"
  }
}
